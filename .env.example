# Copia este archivo como .env solo si necesitas cambiar valores (la app no lee .env automáticamente:
# exporta las variables en tu terminal o configúralas en el servicio de despliegue).
PORT=3000
# 127.0.0.1 = solo este equipo. Usa 0.0.0.0 para exponerla en la red o en un servidor.
HOST=127.0.0.1
# Carpeta donde se guarda la base SQLite (datavision.sqlite).
DATA_DIR=storage
MAX_UPLOAD_MB=5
MAX_ROWS=50000
MAX_COLUMNS=200
# false = no cargar los datos ficticios de demostración en el primer arranque.
SEED_DEMO=true
